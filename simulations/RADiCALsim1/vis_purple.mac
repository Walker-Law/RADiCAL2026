# 1 GeV optical-photon visualization — optical photons drawn purple.
# Run from build/:
#   RADICAL_OPTICAL=1 RADICAL_BEAM_ENERGY_GEV=1 ./radical ../vis_purple.mac

/run/initialize

/vis/open OGL 1000x800
/vis/drawVolume
/vis/viewer/set/viewpointThetaPhi 90 0
/vis/viewer/zoom 2.0
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate 5
/vis/viewer/set/background 0.02 0.02 0.08

# Draw ONLY optical photons (comment out these 2 lines to also see the shower)
/vis/filtering/trajectories/create/particleFilter opticalOnly
/vis/filtering/trajectories/opticalOnly/add opticalphoton

# Colour optical photons purple
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/setRGBA opticalphoton 0.6 0.1 0.9 1.0
/vis/modeling/trajectories/select drawByParticleID-0

/run/beamOn 1
