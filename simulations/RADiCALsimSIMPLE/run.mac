# run.mac — the standard energy sweep: 5 000 events at each of 6 energies.
# MEASURED wall time (2026-07-28, curiosity, 512 threads): ~5 h for the sweep
# — 58.6 s per GeV per 5000 events, linear in energy, so E50+E100+E120 alone
# are 87% of it. Trim the high energies for fast iteration. Statistical errors
# at 5k are ~1.4x wider than a 10k run but still far smaller than any change
# worth noticing (sigma_E/E to ~+-0.3%, sigma_t to ~+-1 ps).
# Writes one file per energy: build/E5GeV.root ... E120GeV.root.
# (/analysis/setFileName is a built-in Geant4 command — to change the energy
#  list just add/remove a setFileName+energy+beamOn block, no C++ needed.)
#
# NOTE: no /run/numberOfThreads here on purpose — the thread count comes from
# RADSIMPLE_THREADS (default: all cores). A macro line would override it and
# silently throttle the machine. Set RADSIMPLE_THREADS=64 (or similar) only if
# a host's ntuple merge misbehaves at high thread counts.
/run/initialize
/run/printProgress 500

/analysis/setFileName E5GeV
/gun/energy 5 GeV
/run/beamOn 5000

/analysis/setFileName E10GeV
/gun/energy 10 GeV
/run/beamOn 5000

/analysis/setFileName E25GeV
/gun/energy 25 GeV
/run/beamOn 5000

/analysis/setFileName E50GeV
/gun/energy 50 GeV
/run/beamOn 5000

/analysis/setFileName E100GeV
/gun/energy 100 GeV
/run/beamOn 5000

/analysis/setFileName E120GeV
/gun/energy 120 GeV
/run/beamOn 5000
