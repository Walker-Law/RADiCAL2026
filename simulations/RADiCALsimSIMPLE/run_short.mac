# run_short.mac — quick 1000-event/energy sweep (same 6 energies as run.mac).
# For a fast turnaround / cross-check while a long run occupies the other cluster.
#
# Thread count comes from RADSIMPLE_THREADS (default: all cores) — deliberately
# NOT set here, since a macro line overrides the env var and would throttle the
# host. Use RADSIMPLE_THREADS=64 if a machine's ntuple merge misbehaves.
/run/initialize
/run/printProgress 200

/analysis/setFileName rootfiles/E5GeV
/gun/energy 5 GeV
/run/beamOn 1000

/analysis/setFileName rootfiles/E10GeV
/gun/energy 10 GeV
/run/beamOn 1000

/analysis/setFileName rootfiles/E25GeV
/gun/energy 25 GeV
/run/beamOn 1000

/analysis/setFileName rootfiles/E50GeV
/gun/energy 50 GeV
/run/beamOn 1000

/analysis/setFileName rootfiles/E100GeV
/gun/energy 100 GeV
/run/beamOn 1000

/analysis/setFileName rootfiles/E120GeV
/gun/energy 120 GeV
/run/beamOn 1000
