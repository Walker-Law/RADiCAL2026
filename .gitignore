# Geant4 source, build, and install (enormous — not for version control)
geant4/
geant4-build/
geant4-install/

# RADiCAL directory has its own embedded git repo
RADiCAL/

# Compiled build directories and artifacts (platform-specific — never commit)
**/build/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# ROOT output data files (large binary)
*.root

# Simulation RUN OUTPUT — regenerated by every run, must never be tracked.
# Committing it caused a real failure (2026-07-29): the auto-commit hook swept
# the Mac's results/ into git, and the next `git pull` on perseverence aborted
# with "untracked working tree files would be overwritten by merge" because
# that cluster had its own run.log/sweep.mac in the same paths. Output belongs
# to the machine that produced it; only source and docs are shared.
**/results/
**/logs/
*.log
# (RADiCALsimLadder/results/ holds two hand-kept study outputs that predate this
#  rule and are NOT regenerated per run — they stay tracked via `git add -f`.)

# macOS metadata
.DS_Store

# CMake cache files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
